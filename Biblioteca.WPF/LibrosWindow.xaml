<UserControl x:Class="Biblioteca.WPF.LibrosWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Mantenimiento de Libros" Style="{StaticResource TituloVentana}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Buscar por título o autor:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="txtBuscar" Width="280" Height="28"/>
            <Button x:Name="btnBuscar" Content="Buscar" Width="90" Height="28" Margin="8,0,0,0" Click="btnBuscar_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgLibros" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False" SelectionChanged="dgLibros_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding LibroId}" Width="50"/>
                <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="*"/>
                <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="130"/>
                <DataGridTextColumn Header="Autor" Binding="{Binding AutorNombre}" Width="180"/>
                <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Título:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="txtTitulo" Grid.Row="0" Grid.Column="1" Height="28" Margin="0,0,16,8"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="ISBN:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="txtIsbn" Grid.Row="0" Grid.Column="3" Height="28" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Autor:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <ComboBox x:Name="cboAutor" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,16,8"
                      DisplayMemberPath="Nombre" SelectedValuePath="AutorId"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Ejemplares:" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox x:Name="txtEjemplares" Grid.Row="1" Grid.Column="3" Height="28" Margin="0,0,0,8"/>

            <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button x:Name="btnNuevo" Content="Nuevo" Width="90" Height="30" Margin="0,0,8,0"
                        Style="{StaticResource BotonSecundario}" Click="btnNuevo_Click"/>
                <Button x:Name="btnGuardar" Content="Guardar" Width="90" Height="30" Margin="0,0,8,0" Click="btnGuardar_Click"/>
                <Button x:Name="btnEliminar" Content="Eliminar" Width="90" Height="30"
                        Style="{StaticResource BotonPeligro}" Click="btnEliminar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>