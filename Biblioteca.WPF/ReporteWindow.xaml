<UserControl x:Class="Biblioteca.WPF.ReporteWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reporte de Préstamos por Fechas" Style="{StaticResource TituloVentana}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker x:Name="dpDesde" Width="140" Height="28"/>
            <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <DatePicker x:Name="dpHasta" Width="140" Height="28"/>
            <Button x:Name="btnConsultar" Content="Consultar" Width="100" Height="28" Margin="16,0,0,0" Click="btnConsultar_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgReporte" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N° Préstamo" Binding="{Binding PrestamoId}" Width="100"/>
                <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="200"/>
                <DataGridTextColumn Header="Libros" Binding="{Binding Libros}" Width="*"/>
                <DataGridTextColumn Header="Fecha préstamo" Binding="{Binding FechaPrestamo, StringFormat=dd/MM/yyyy}" Width="120"/>
                <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="txtTotal" Grid.Row="3" Margin="0,12,0,0" FontWeight="SemiBold"
                   Foreground="{StaticResource BrushPrimario}"/>
    </Grid>
</UserControl>