<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema de Biblioteca" Height="720" Width="1200" MinHeight="620" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource VentanaBase}"
        Background="#F1F4F9">

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C9D6EA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                Padding="16,0" Height="46" Margin="0,0,0,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2B4A78"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menú lateral -->
        <Border Grid.Column="0" Background="#14263F" Padding="18,26,18,18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Arquitectura en capas · SEMANA07"
                           Foreground="#7F95B5" FontSize="11" TextWrapping="Wrap" Margin="4,12,0,0"/>
                <StackPanel>
                    <StackPanel Margin="4,0,0,28">
                        <TextBlock Text="📚 Biblioteca" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Sistema de gestión" Foreground="#7F95B5" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>

                    <TextBlock Text="MANTENIMIENTO" Foreground="#6F87AA" FontSize="11" FontWeight="Bold" Margin="6,0,0,8"/>
                    <RadioButton x:Name="rbLibros" GroupName="menu" Content="📖  Libros" Style="{StaticResource NavItem}" Click="btnLibros_Click"/>
                    <RadioButton x:Name="rbSocios" GroupName="menu" Content="👥  Socios" Style="{StaticResource NavItem}" Click="btnSocios_Click"/>

                    <TextBlock Text="OPERACIONES" Foreground="#6F87AA" FontSize="11" FontWeight="Bold" Margin="6,18,0,8"/>
                    <RadioButton x:Name="rbPrestamo" GroupName="menu" Content="📤  Registrar préstamo" Style="{StaticResource NavItem}" Click="btnPrestamo_Click"/>
                    <RadioButton x:Name="rbDevolucion" GroupName="menu" Content="📥  Registrar devolución" Style="{StaticResource NavItem}" Click="btnDevolucion_Click"/>

                    <TextBlock Text="CONSULTAS" Foreground="#6F87AA" FontSize="11" FontWeight="Bold" Margin="6,18,0,8"/>
                    <RadioButton x:Name="rbReporte" GroupName="menu" Content="📊  Reporte de préstamos" Style="{StaticResource NavItem}" Click="btnReporte_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Área de contenido -->
        <Border Grid.Column="1" Margin="22" Padding="22" Background="White" CornerRadius="12"
                BorderBrush="{StaticResource BrushBorde}" BorderThickness="1">
            <ContentControl x:Name="contenido"/>
        </Border>
    </Grid>
</Window>